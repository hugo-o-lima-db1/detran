# ============================================================================
#  Configuração da automação de agendamento do exame psicológico (DETRAN-PR)
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================================

# --- Identificação do requerente -------------------------------------------
# São os MESMOS dados que você digita no portal para acessar o agendamento.
# CPF (somente números ou com máscara, tanto faz).
DETRAN_CPF=00000000000
# Número do processo / RENACH (o que o site pede junto do CPF para entrar).
DETRAN_PROCESSO=

# --- Serviço ----------------------------------------------------------------
# 749 = Avaliação psicológica. Não altere a menos que o DETRAN mude o código.
DETRAN_SERVICO=749

# --- Comportamento ----------------------------------------------------------
# true  = agenda automaticamente a PRIMEIRA data disponível encontrada.
# false = apenas avisa que há vaga, sem agendar (modo "só monitorar").
AUTO_BOOK=true

# Restringe as datas aceitas ao agendar automaticamente (opcional).
# Formato ISO YYYY-MM-DD. Deixe em branco para aceitar qualquer data.
DATA_MINIMA=
DATA_MAXIMA=

# Filtra por cidade/unidade credenciada (opcional, texto parcial, sem acento
# importa pouco — a busca é case-insensitive e ignora acentos).
# Ex.: CURITIBA
CIDADE_PREFERIDA=

# --- Execução do navegador --------------------------------------------------
# true  = navegador invisível (headless) — use no modo agendado/servidor.
# false = navegador visível — útil só para depurar (ver a tela).
HEADLESS=true

# Pasta de perfil do navegador. Não versionar. (Não é preciso login aqui —
# o acesso é só com CPF + processo.)
USER_DATA_DIR=./user-data

# Tempo máximo (ms) que a automação espera por cada passo da página.
STEP_TIMEOUT_MS=45000

# --- Notificações (opcionais; configure ao menos uma) ----------------------
# Telegram: crie um bot no @BotFather e pegue o token; o chat_id é o do
# destino (você mesmo, ou um grupo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook genérico: recebe um POST JSON { "text": "..." } a cada evento.
# Serve para Discord, Slack (use o formato deles) ou qualquer endpoint próprio.
WEBHOOK_URL=

# E-mail via SMTP (opcional). Requer os 4 campos preenchidos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
